# Cấu hình broker trên server. Dùng: cp .env.example .env rồi sửa file .env
# (file .env không được commit lên GitHub).

# Để `docker compose ...` tự dùng cấu hình server, không phải gõ -f mỗi lần.
COMPOSE_FILE=docker-compose.server.yml
COMPOSE_PROJECT_NAME=message-broker

# Bảng định tuyến tĩnh: agent_id=webhook_url, nhiều agent cách nhau bởi dấu phẩy, không có dấu cách.
# Giữ agent_B: đó là test-agent chạy nội bộ để kiểm tra broker.
# dieu_phoi và tin_tuc là hai agent demo (DEMO.md), chỉ chạy khi bật profile demo.
# Agent không có webhook (chỉ kéo tin bằng GET /receive): ghi dạng team_08_news=pull.
# Ví dụ thêm một nhóm: nối thêm ,team_08_news=http://1.2.3.4:9000/webhook/receive vào cuối dòng.
AGENT_ROUTES=agent_B=http://test-agent:8081/webhook/receive,dieu_phoi=http://demo-dieu-phoi:9101/webhook/receive,tin_tuc=http://demo-tin-tuc:9102/webhook/receive

# Service Registry của Team 1, để trống khi chưa có. Phải chứa {agent_id},
# ví dụ: http://registry.example:8082/agents/{agent_id}
REGISTRY_LOOKUP_URL=

# Chờ ACK bao lâu trước khi gửi lại tin.
RETRY_INTERVAL=5s
